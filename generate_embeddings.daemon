#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["sentence-transformers", "numpy"]
# ///
"""Unix-socket service for generate_embeddings."""

import argparse
import json
import os
import signal
import socket
import socketserver
import sys
import time
from pathlib import Path

SOCKET_PATH = Path.home() / ".cache" / "generate_embeddings" / "daemon.sock"
PID_PATH = SOCKET_PATH.with_suffix(".pid")
MODEL = None
GREEN = "\\033[32m"
RED = "\\033[31m"
RESET = "\\033[0m"
ACTION = "start"


def report(message, color=""):
    if not sys.stderr.isatty():
        return
    rendered = f"{color}{message}{RESET}" if color else message
    print(rendered, file=sys.stderr, flush=True)


class EmbeddingHandler(socketserver.StreamRequestHandler):
    def handle(self):
        global MODEL
        line = self.rfile.readline()
        if not line:
            return
        try:
            request = json.loads(line)
            scalar = "texts" not in request
            texts = [request.get("text")] if scalar else request.get("texts")
            if not isinstance(texts, list) or not texts or any(not isinstance(text, str) for text in texts):
                raise ValueError('request must contain a string "text" or nonempty string array "texts"')
            if len(texts) > 64:
                raise ValueError("batch exceeds maximum of 64 texts")
            if MODEL is None:
                raise RuntimeError("Embedding model is not loaded")
            vectors = MODEL.encode(texts, batch_size=64, show_progress_bar=False)
            values = vectors.tolist() if hasattr(vectors, "tolist") else [list(vector) for vector in vectors]
            response = {"embedding": values[0]} if scalar else {"embeddings": values}
        except Exception as error:
            response = {"error": str(error)}
        try:
            self.wfile.write((json.dumps(response) + "\n").encode("utf-8"))
        except OSError:
            pass


class UnixServer(socketserver.UnixStreamServer):
    allow_reuse_address = True


def stop_existing(force):
    pid = None
    try:
        pid = int(PID_PATH.read_text().strip())
    except (FileNotFoundError, ValueError):
        pass
    if pid:
        try:
            os.kill(pid, 0)
            alive = True
        except ProcessLookupError:
            alive = False
        except PermissionError as error:
            raise RuntimeError(f"Cannot inspect daemon process {pid}") from error
        if alive and not force:
            raise RuntimeError(f"Daemon already running (PID {pid}) at {SOCKET_PATH}")
        if alive:
            os.kill(pid, signal.SIGTERM)
            deadline = time.monotonic() + 5
            while time.monotonic() < deadline:
                try:
                    os.kill(pid, 0)
                except ProcessLookupError:
                    break
                time.sleep(0.05)
            else:
                os.kill(pid, signal.SIGKILL)
                time.sleep(0.1)
    if PID_PATH.exists():
        PID_PATH.unlink()
    if SOCKET_PATH.exists():
        if not SOCKET_PATH.is_socket():
            raise RuntimeError(f"Socket path exists and is not a socket: {SOCKET_PATH}")
        SOCKET_PATH.unlink()


def start(timeout_minutes, force):
    global MODEL
    SOCKET_PATH.parent.mkdir(parents=True, exist_ok=True)
    stop_existing(force)
    pid = os.fork()
    if pid:
        deadline = time.monotonic() + 300
        while time.monotonic() < deadline:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                    probe.connect(str(SOCKET_PATH))
                verb = "restarted" if force else "started"
                report(f"✓ Daemon {verb} at {SOCKET_PATH}", GREEN)
                return
            except OSError:
                time.sleep(0.05)
        raise RuntimeError("Daemon failed to start")

    os.setsid()
    server = None
    stopping = False

    def request_stop(signum, frame):
        nonlocal stopping
        stopping = True

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT):
        signal.signal(sig, request_stop)
    try:
        with open(os.devnull, "r+") as null:
            for fd in (0, 1, 2):
                os.dup2(null.fileno(), fd)
        from sentence_transformers import SentenceTransformer
        MODEL = SentenceTransformer("all-MiniLM-L6-v2", device="cpu")
        server = UnixServer(str(SOCKET_PATH), EmbeddingHandler)
        server.timeout = 1
        PID_PATH.write_text(str(os.getpid()))
        end = time.monotonic() + timeout_minutes * 60 if timeout_minutes else None
        while not stopping and (end is None or time.monotonic() < end):
            server.handle_request()
    finally:
        if server is not None:
            server.server_close()
        try:
            if PID_PATH.read_text().strip() == str(os.getpid()):
                PID_PATH.unlink()
                if SOCKET_PATH.exists() and SOCKET_PATH.is_socket():
                    SOCKET_PATH.unlink()
        except FileNotFoundError:
            pass
    os._exit(0)


def main():
    global ACTION
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group()
    action.add_argument("--force", action="store_true", help="stop any existing daemon and replace it")
    action.add_argument("--stop", action="store_true", help="stop any running daemon and exit")
    parser.add_argument("--timeout", type=int, default=0, help="lifetime in minutes (0 means unlimited)")
    args = parser.parse_args()
    if args.timeout < 0:
        parser.error("--timeout must be nonnegative")
    if args.stop:
        ACTION = "stop"
        report("Stopping daemon...", "")
        stop_existing(force=True)
        report("✓ Daemon stopped", GREEN)
        return
    ACTION = "restart" if args.force else "start"
    report("Restarting daemon..." if args.force else "Starting daemon...", "")
    start(args.timeout, args.force)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        if sys.stderr.isatty():
            report(f"✗ Failed to {ACTION} daemon: {error}", RED)
        else:
            print(f"Error: {error}", file=sys.stderr)
        raise SystemExit(1)
