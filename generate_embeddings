#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Generate text embeddings through the local embedding daemon."""

import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

SOCKET_PATH = Path.home() / ".cache" / "generate_embeddings" / "daemon.sock"
REQUEST_BATCH_SIZE = 10_000
DAEMON_SCRIPT = Path(__file__).with_name("generate_embeddings.daemon")

HELP = """Usage: ./generate_embeddings [OPTIONS] [TEXT...]

Generates embeddings using all-MiniLM-L6-v2. Normal invocations reuse the
Unix-socket daemon, or start one with a 1-minute timeout if none is available.

Options:
  -             Read text from stdin (cannot be combined with text arguments).
  --json        Output each embedding as a JSON array.
  -0            With stdin, read NUL-delimited strings in batches of up to 10,000; ignored in text mode.
  --daemon [N]  Launch the daemon for N minutes (default: 0, unlimited).
  --            Treat following arguments literally as text.
  --help        Show this help.
  --version     Show version.
"""


def parse_args(args):
    use_json = False
    use_stdin = False
    use_nul = False
    daemon_minutes = None
    text_args = []
    while args:
        arg = args.pop(0)
        if arg == "--":
            text_args.extend(args)
            break
        if arg == "--help":
            print(HELP, end="")
            raise SystemExit(0)
        if arg == "--version":
            print("1.0.0")
            raise SystemExit(0)
        if arg == "--json":
            use_json = True
        elif arg == "-0":
            use_nul = True
        elif arg == "-":
            use_stdin = True
        elif arg == "--daemon":
            daemon_minutes = 0
            if args and args[0].isdigit():
                daemon_minutes = int(args.pop(0))
        else:
            text_args.append(arg)
    return use_json, use_stdin, use_nul, daemon_minutes, text_args


def connect_to_daemon():
    def available():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.connect(str(SOCKET_PATH))
            return True
        except OSError:
            return False

    if available():
        return
    subprocess.run(
        [str(DAEMON_SCRIPT), "--timeout", "5"],
        stdout=subprocess.DEVNULL,
        check=False,
    )
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        if available():
            return
        time.sleep(0.05)
    raise RuntimeError("Could not start embedding daemon")


def request_embeddings(texts):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(120)
        client.connect(str(SOCKET_PATH))
        with client.makefile("rwb") as channel:
            request = {"text": texts[0]} if len(texts) == 1 else {"texts": texts}
            channel.write((json.dumps(request) + "\n").encode("utf-8"))
            channel.flush()
            response = json.loads(channel.readline())
    if "error" in response:
        raise RuntimeError(response["error"])
    if len(texts) == 1 and "embedding" in response:
        return [response["embedding"]]
    embeddings = response.get("embeddings")
    if not isinstance(embeddings, list) or len(embeddings) != len(texts):
        raise RuntimeError("Daemon returned an invalid batch response")
    return embeddings


def emit_batch(texts, use_json):
    embeddings = request_embeddings(texts)
    if len(embeddings) != len(texts):
        raise RuntimeError("Daemon returned an invalid batch response")
    for embedding in embeddings:
        print(json.dumps(embedding) if use_json else " ".join(map(str, embedding)), flush=True)


def main():
    use_json, use_stdin, use_nul, daemon_minutes, text_args = parse_args(sys.argv[1:])
    if daemon_minutes is not None:
        result = subprocess.run([str(DAEMON_SCRIPT), "--timeout", str(daemon_minutes)], check=False)
        return result.returncode
    if use_stdin and text_args:
        print("Error: '-' cannot be combined with text arguments; use '--' to pass a literal '-'.", file=sys.stderr)
        return 2
    if use_stdin and use_nul:
        connect_to_daemon()
        batch = []
        remainder = b""
        for raw in iter(lambda: sys.stdin.buffer.read(64 * 1024), b""):
            pieces = (remainder + raw).split(b"\0")
            remainder = pieces.pop()
            for piece in pieces:
                batch.append(piece.decode("utf-8"))
                if len(batch) == REQUEST_BATCH_SIZE:
                    emit_batch(batch, use_json)
                    batch = []
        if remainder:
            batch.append(remainder.decode("utf-8"))
        if batch:
            emit_batch(batch, use_json)
        return 0
    if use_stdin:
        texts = [sys.stdin.buffer.read().decode("utf-8").strip()]
    else:
        texts = [" ".join(text_args)]
    if not texts[0]:
        return 0
    connect_to_daemon()
    emit_batch(texts, use_json)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"Error: {error}", file=sys.stderr)
        raise SystemExit(1)
